{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local app can scan and clean candidates from its last verified scan",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-get-last-scan",
    "allow-clean-items",
    "allow-reveal-item",
    "allow-open-trash",
    "allow-get-analysis-locations",
    "allow-get-disk-overview",
    "allow-choose-analysis-directory",
    "allow-analyze-directory",
    "allow-browse-analysis-directory",
    "allow-inspect-analysis-node",
    "allow-cancel-analysis",
    "allow-reveal-analysis-node",
    "allow-open-privacy-settings"
  ]
}
